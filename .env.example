# Your live site address, no trailing slash (used inside QR codes and emails)
SITE_URL=https://tickets.yourdomain.com

# Supabase > Project settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Long random secret that signs every ticket. Generate: openssl rand -base64 48
# Never change it after tickets are sold, or old QR codes stop working.
TICKET_SECRET=

# Logins
ADMIN_PASSWORD=
STAFF_PIN=

# Resend (resend.com) — verify your domain first
RESEND_API_KEY=
EMAIL_FROM="Dandiya Night <tickets@yourdomain.com>"

# Manual UPI (leave UPI_ID empty to hide this option)
UPI_ID=
UPI_PAYEE_NAME=

# Razorpay (leave empty until your account is approved)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
